# Copy to backend/.env (never committed) and adjust as needed.
# All values below are safe defaults for the deterministic demo.

# SQLite database path. Relative paths resolve against the repository root.
EVALPILOT_DB_PATH=backend/data/evalpilot.db

# OpenAI-compatible chat-completions endpoint for the optional live-LLM mode.
# The deterministic demo never calls this: runs, investigations and the judge
# all work offline without it.
EVALPILOT_LLM_BASE_URL=
EVALPILOT_LLM_API_KEY=
EVALPILOT_LLM_MODEL=

# Live-LLM mode (docs/V3_LLM_INTERFACES.md).
#   deterministic (default) -- offline, reproducible, no key, no network
#   live                    -- the model proposes risk hypotheses and explains
#                              the release decision; the measured verdict, risk
#                              level, evidence ids and counterfactual results
#                              stay authoritative and are never overwritten
# Live mode needs all three values above; if any is missing the backend reports
# the mode on GET /api/runtime and runs deterministically instead of failing.
EVALPILOT_LLM_MODE=deterministic

# Per-request LLM timeout in seconds. Applies to each chat-completions call; a
# timeout is recorded as an explicit fallback reason on the affected step.
EVALPILOT_LLM_TIMEOUT_SECONDS=45

# Allowlisted Python tool. Disabled unless explicitly enabled.
EVALPILOT_ENABLE_PYTHON_TOOL=false

# Deterministic fixtures for the seeded demo.
EVALPILOT_DEMO_MODE=true

# Simulated per-step latency in seconds; 0 makes runs complete as fast as possible.
EVALPILOT_STEP_DELAY=0.05
